function Social:Clock(stamp)
    local year, month, day, hour, minute, second =
        tostring(stamp or ''):match('(%d%d%d%d)-(%d%d)-(%d%d)T(%d%d):(%d%d):(%d%d)')

    if not year then
        return ''
    end

    local ok, moment = pcall(
        DateTime.fromUniversalTime,
        tonumber(year),
        tonumber(month),
        tonumber(day),
        tonumber(hour),
        tonumber(minute),
        tonumber(second)
    )

    if not ok then
        return ''
    end

    local shown, clock = pcall(function()
