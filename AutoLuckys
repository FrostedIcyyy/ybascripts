function Window:SelectCategory(category)
    if self.Active == category then
        return
    end

    local leaving = self.Active
    local leavingPage = leaving and leaving.Active

    self.Active = category

    for _, other in ipairs(self.Categories)do
        local selected = other == category

        other.Selected = selected
        other.Strip.Visible = selected

        Tween(other.Icon, {
            ImageColor3 = selected and Theme.Text or Theme.Dim,
        }, STATE)
        Tween(other.IconScale, {
            Scale = selected and 1.08 or 1,
        }, STATE)

        if not selected then
            for _, page in ipairs(other.Pages)do
                if page ~= leavingPage then
                    page.Frame.Visible = false
                end
            end
        end
    end

    if self.RailTile.Visible then
        Tween(self.RailTile, {
            Position = UDim2.new(0.5, -1, 0, category.Top),
        }, SMOOTH)
        Tween(self.Indicator, {
            Position = UDim2.new(1, 0, 0, category.Top + (RAIL_ITEM - RAIL_MARK) / 2),
        }, SMOOTH)
    else
        self.RailTile.Position = UDim2.new(0.5, -1, 0, category.Top)
        self.RailTile.Visible = true
        self.Indicator.Position = UDim2.new(1, 0, 0, category.Top + (RAIL_ITEM - RAIL_MARK) / 2)
        self.Indicator.Visible = true
    end
    if leavingPage then
        Fade(leavingPage.Frame, 1, CAT_OUT)
        Tween(leavingPage.Frame, {
            Position = UDim2.fromOffset(0, 30),
        }, CAT_OUT)
        task.delay(0.4, function()
            if self.Active ~= leaving then
                leavingPage.Frame.Visible = false
                leavingPage.Frame.Position = UDim2.fromOffset(0, 0)
            end
        end)
    end

    local page = category.Active or category.Pages[1]

    if page then
        category.Active = nil

        if leavingPage then
            task.delay(CAT_STAGGER, function()
                if self.Active == category then
                    category:Select(page)
                end
            end)
        else
            category:Select(page)
        end
    end
