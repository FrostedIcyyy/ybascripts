function Cloud:Apply(entry)
    if type(entry) ~= 'table' or type(entry.data) ~= 'table' then
        return false, 'empty config'
    end

    for flag, value in pairs(entry.data)do
        local control = Library.Controls[flag]

        if control then
            if control.Type == 'Color' and type(value) == 'string' then
                control:Set(FromHex(value))
            else
                control:Set(value)
            end
        end
    end

    return true
end

local function AdoptName(entry)
    local name = tostring(entry.name or ''):gsub('[^%w%s%-_]', ''):gsub('%s+', ' ')

    name = name:gsub('^%s+', ''):gsub('%s+$', '')

    if name == '' then
        name = 'Community config'
    end
    if #name > 40 then
        name = name:sub(1, 40)
    end
    if entry.code and entry.code ~= '' then
        name = ('%s (%s)'):format(name, entry.code)
    end

    return name
end

function Cloud:Adopt(entry)
    local ok, reason = self:Apply(entry)

    if not ok then
        return false, reason
    end

    local name = AdoptName(entry)
    local saved = Library:SaveConfig(name)

    if not saved then

        return true, nil, name, false
    end

    Library:SetPref('Active', name)

    if Library.OnConfigsChanged then
        pcall(Library.OnConfigsChanged, name)
    end

    return true, nil, name, true
end

