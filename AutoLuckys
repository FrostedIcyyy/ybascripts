        local view = gui.AbsoluteSize

        if view.X <= 0 or view.Y <= 0 then
            return
        end

        local margin = IS_TOUCH and 40 or 24
        local height = self.WindowH or WINDOW_H

        self.BaseScale = math.min(
            UI_SCALE * (self.UserScale or 1),
            (view.X - margin) / WINDOW_W,
            (view.Y - margin) / height
        )

        if self.Shown then
