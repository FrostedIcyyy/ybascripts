function Window:Filter(query)
    query = tostring(query or ''):lower()

    local current = self.Active and self.Active.Active
    local currentHasHits = false
    local firstHit

    for _, group in ipairs(self.Groups)do
        local shown = 0

        for _, row in ipairs(group.Rows)do
            local match = query == '' or row.Search:find(query, 1, true) ~= nil

            row.Frame.Visible = match

            if match then
                shown += 1
            end
        end

        if group.Header then
            group.Header.Visible = shown > 0
        end

        group.Card.Visible = shown > 0

        group:Refresh()

        if shown > 0 then
            local page = group.Column.Page

            if page == current then
                currentHasHits = true
            elseif not firstHit then
                firstHit = page
            end
        end
    end

    if query ~= '' and not currentHasHits and firstHit then
        self:SelectCategory(firstHit.Category)
        firstHit.Category:Select(firstHit)
    end
end
