function Category:Select(page)
    if self.Active == page then
        return
    end

    local previous = self.Active

    self.Active = page

    for _, other in ipairs(self.Pages)do
        local selected = other == page

        other.Selected = selected

        Tween(other.Label, {
            TextColor3 = selected and Theme.Text or Theme.Idle,
        }, STATE)
        Tween(other.Icon, {
            ImageColor3 = selected and Theme.Text or Theme.Idle,
        }, STATE)
    end

    if self.Highlight.Visible then
        Tween(self.Highlight, {
            Position = UDim2.fromOffset(page.X, 0),
            Size = UDim2.fromOffset(page.W, PILL_H),
        }, SMOOTH)
    else
        self.Highlight.Position = UDim2.fromOffset(page.X, 0)
        self.Highlight.Size = UDim2.fromOffset(page.W, PILL_H)
        self.Highlight.Visible = true
    end
    if previous then
        Fade(previous.Frame, 1, PAGE_OUT)
        Tween(previous.Frame, {
            Position = UDim2.fromOffset(0, 26),
        }, PAGE_OUT)
        task.delay(0.32, function()
            if self.Active ~= previous then
                previous.Frame.Visible = false
                previous.Frame.Position = UDim2.fromOffset(0, 0)
            end
        end)
    end
    if self.Window.Active ~= self then
        page.Frame.Visible = false

        return
    end

    local function reveal()
        if self.Active ~= page then
            return
        end

        page.Frame.Visible = true
        page.Frame.Position = UDim2.fromOffset(0, 34)

        Tween(page.Frame, {
            Position = UDim2.fromOffset(0, 0),
        }, PAGE_IN)
        Fade(page.Frame, 0, PAGE_IN)
    end

    if previous then
        task.delay(PAGE_STAGGER, reveal)
    else
        reveal()
    end
end
