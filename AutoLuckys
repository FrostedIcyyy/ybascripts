        local origin = window.Main.AbsolutePosition
        local at = swatch.AbsolutePosition
        local size = swatch.AbsoluteSize
        local factor = window.Scale.Scale
        local localX = (at.X - origin.X) / factor
        local localY = (at.Y - origin.Y) / factor

        local bottom = window.Main.AbsolutePosition.Y + window.Main.AbsoluteSize.Y
        local roomBelow = bottom - (at.Y + size.Y + 6 * factor)
        local flip = roomBelow < PICK_H * factor

        panel.Position = UDim2.fromOffset(localX + (size.X / factor) - PICK_W, flip and (localY - PICK_H - 6) or (localY + DROP_H + 6))
    end
    local function setOpen(state)
        if open == state then
            return
        end

        open = state

        if state then
            panel.Visible = true

            reposition()

            panel.Size = UDim2.fromOffset(PICK_W, 0)

            Tween(panel, {
                Size = UDim2.fromOffset(PICK_W, PICK_H),
            }, SMOOTH)

            follow = RunService.RenderStepped:Connect(reposition)
        else
            if follow then
                follow:Disconnect()

                follow = nil
            end

            Tween(panel, {
                Size = UDim2.fromOffset(PICK_W, 0),
            }, SNAP)
            task.delay(0.2, function()
                if not open then
                    panel.Visible = false
                end
            end)
        end
    end

    swatch.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)
    UserInputService.InputBegan:Connect(function(input)
        if not open then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if not InBounds(panel, input.Position) and not InBounds(swatch, input.Position) then
            setOpen(false)
        end
    end)

    control.Type = 'Color'
    control.Name = config.Name
    control.Scope = self.Scope
    control.Section = self.Section

    if flag then
        Library.Controls[flag] = control
    end

    apply(true)

    return control
end
function Group:Entry(config)
    config = config or {}

    local actions = config.Actions or {}
    local widths, total = {}, 0

    for index, action in ipairs(actions)do
        local width = action.Text and math.max(ENTRY_BTN, math.ceil(TextWidth(action.Text, ENTRY_TEXT)) + ENTRY_PAD * 2) or ENTRY_BTN

        widths[index] = width

        total += width + (index > 1 and ENTRY_GAP or 0)
    end

    local frame, slot, title = self:_row(config, #actions > 0 and math.max(total, ENTRY_BTN) or 0)
    local row = New('Frame', {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(0, ENTRY_BTN),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        Parent = slot,
    })
    local rowList = List(row, Enum.FillDirection.Horizontal, ENTRY_GAP)

    rowList.HorizontalAlignment = Enum.HorizontalAlignment.Right

    local chipped = false

    for _, action in ipairs(actions)do
        if action.Text then
            chipped = true

            break
        end
    end
    for index, action in ipairs(actions)do
        local label = action.Text
        local button = New('TextButton', {
            Size = UDim2.fromOffset(widths[index], ENTRY_BTN),
            BackgroundColor3 = Theme.Control,
            BackgroundTransparency = chipped and 0 or 1,
            BorderSizePixel = 0,
            Text = '',
            AutoButtonColor = false,
            LayoutOrder = index,
            Parent = row,
        })

        if chipped then
            Corner(button, 9)
        end

        local rest = action.Danger and Theme.Accent or Theme.Idle

        if label then
            local text = New('TextLabel', {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                FontFace = Fonts.Medium,
                Text = label,
                TextSize = ENTRY_TEXT,
                TextColor3 = rest,
                Parent = button,
            })

            if action.Danger then
                Accented(text, 'TextColor3')
            end

            button.MouseEnter:Connect(function()
                Tween(text, {
                    TextColor3 = Theme.Text,
                }, SNAP)
            end)
            button.MouseLeave:Connect(function()
                Tween(text, {
                    TextColor3 = action.Danger and Theme.Accent or Theme.Idle,
                }, SNAP)
            end)
            button.MouseButton1Click:Connect(function()
                if action.Callback then
                    task.spawn(action.Callback)
                end
            end)

            continue
        end

        local icon = New('ImageLabel', {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(ENTRY_ICON, ENTRY_ICON),
            BackgroundTransparency = 1,
            Image = action.Icon or '',
            ImageColor3 = rest,
            ScaleType = Enum.ScaleType.Fit,
            Parent = button,
        })
        local glyph = New('TextLabel', {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            FontFace = Fonts.Medium,
            Text = action.Glyph or '?',
            TextSize = 16,
            TextColor3 = rest,
            Visible = false,
            Parent = button,
        })

        task.spawn(function()
            task.wait(1)

            if not icon.IsLoaded then
                icon.Visible = false
                glyph.Visible = true
            end
        end)

        if action.Danger then
            Accented(icon, 'ImageColor3')
            Accented(glyph, 'TextColor3')
        end

        button.MouseEnter:Connect(function()
            Tween(icon, {
                ImageColor3 = Theme.Text,
            }, SNAP)
        end)
        button.MouseLeave:Connect(function()
            Tween(icon, {
                ImageColor3 = action.Danger and Theme.Accent or Theme.Idle,
            }, SNAP)
        end)
        button.MouseButton1Click:Connect(function()
            if action.Callback then
                task.spawn(action.Callback)
            end
        end)
    end

    title.TextColor3 = Theme.Text

    return frame
end
function Group:Label(text)
    local frame, _, title = self:_row({Name = text})

    title.TextColor3 = Theme.DescOff
    title.TextSize = DESC_SIZE
    title.FontFace = Fonts.Regular

    return frame
end

