local function MigratePlaceFolder()

    local function absorb(old)
        if not HAS_FILES or old == FOLDER or not isfolder(old) then
            return
        end

        pcall(function()
            for _, path in ipairs(listfiles(old))do
                local name = path:match('([^/\\]+%.json)$')
                local destination = name and (FOLDER .. '/' .. name)

                if destination and not isfile(destination) then
                    writefile(destination, readfile(path))
                end
            end
        end)
    end

    absorb(ROOT_FOLDER .. '/' .. tostring(game.PlaceId))

    absorb('ui_library_v2/' .. GAME_KEY)
    absorb('ui_library_v2/' .. tostring(game.PlaceId))
end

