        Size = UDim2.fromOffset(SL_W, SL_H),
        BackgroundColor3 = Theme.Track,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = slot,
    })

    Corner(track, SL_RADIUS)

    local fill = New('Frame', {
        Size = UDim2.fromOffset(0, SL_H),
        BorderSizePixel = 0,
        BackgroundColor3 = Theme.White,
        Parent = track,
    })

    Corner(fill, SL_RADIUS)

    local gradient = New('UIGradient', {
        Color = ColorSequence.new(Theme.AccentDeep, Theme.Accent),
        Parent = fill,
    })
    local handle = New('Frame', {
        Size = UDim2.fromOffset(SL_HANDLE, SL_H),
        BackgroundColor3 = Theme.Knob,
        BorderSizePixel = 0,
        Parent = track,
    })

    Corner(handle, SL_RADIUS)

    local hit = New('TextButton', {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 8, 0.5, 0),
        Size = UDim2.fromOffset(SL_W + 16, 36),
        BackgroundTransparency = 1,
        Text = '',
        AutoButtonColor = false,
        ZIndex = 3,
        Parent = slot,
    })
    local control = {}
    local dragging = false
    local lastLeft = nil

    function control:Set(target, silent)
        value = Snap(target, min, max, step, decimals)

        local alpha = (max > min) and (value - min) / (max - min) or 0
        local travel = SL_W - SL_HANDLE
        local left = alpha * travel

        lastLeft = left

        local handlePos = UDim2.fromOffset(left, 0)
        local fillSize = UDim2.fromOffset(left + SL_HANDLE, SL_H)
        local info = dragging and FOLLOW or SLIDE

        Tween(handle, {Position = handlePos}, info)
        Tween(fill, {Size = fillSize}, info)
        if not readout:IsFocused() then
            readout.Text = Format(value, decimals) .. suffix
        end
        if flag then
            Library.Flags[flag] = value
            Library:MarkDirty()
        end
        if not silent and config.Callback then
            task.spawn(config.Callback, value)
        end
    end
    function control:Get()
        return value
    end

    BindDrag(hit, track, function(alpha, active)
        dragging = active

        control:Set(min + (max - min) * alpha)

