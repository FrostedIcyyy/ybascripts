function Chrome.BindHover(frame, title, rest)
    local token = 0

    local function set(state)
        token += 1

        local mine = token

        task.delay(HOVER_DELAY, function()
            if mine ~= token then
                return
            end

            local base = rest and rest() or Theme.Idle

            Tween(title, {
                TextColor3 = state and Blend(Theme.White, base, HOVER_LIFT) or base,
            }, STATE)
        end)
    end

    frame.MouseEnter:Connect(function()
        set(true)
    end)
    frame.MouseLeave:Connect(function()
        set(false)
    end)

    return function()
        token += 1
    end
end

function Group:Toggle(config)
    config = config or {}

    local flag = FlagFor(config)
    local value = config.Default or false
    local frame, slot, title, desc = self:_row(config, SLOT_FOR.Toggle)
    local button = New('TextButton', {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = '',
        AutoButtonColor = false,
        Parent = frame,
    })
    local cancelHover = Chrome.BindHover(button, title, function()
        return value and Theme.Text or Theme.Idle
    end)
    local track = New('Frame', {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(SW_W, SW_H),
