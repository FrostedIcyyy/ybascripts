    local open, follow = false, nil
    local rows = {}
    local menuHeight = math.min(#options * 34 + 12, 220)

    local function reposition()
        local origin = window.Main.AbsolutePosition
        local at = button.AbsolutePosition
        local size = button.AbsoluteSize
        local factor = window.Scale.Scale
        local localX = (at.X - origin.X) / factor
        local localY = (at.Y - origin.Y) / factor

        local bottom = window.Main.AbsolutePosition.Y + window.Main.AbsoluteSize.Y
        local roomBelow = bottom - (at.Y + size.Y + 6 * factor)
        local flip = roomBelow < menuHeight * factor

        menu.Position = UDim2.fromOffset(localX, flip and (localY - menuHeight - 6) or (localY + DROP_H + 6))
    end
    local function refresh()
        local picked = {}

        for _, option in ipairs(options)do
            if selected[option] then
                table.insert(picked, option)
            end
        end

        display.Text = #picked > 0 and table.concat(picked, ', ') or placeholder

        for option, row in pairs(rows)do
            local on = selected[option] or false

            Tween(row.Label, {
                TextColor3 = on and Theme.Text or Theme.Idle,
            }, STATE)
            Tween(row.Dot, {
                BackgroundTransparency = on and 0 or 1,
            }, STATE)
        end

        local current = multi and picked or picked[1]

        if flag then
            Library.Flags[flag] = current
            Library:MarkDirty()
        end

        return current
    end
    local function setOpen(state)
        if open == state then
            return
        end

        open = state

        Tween(chevron, {
            Rotation = state and 180 or 0,
        }, STATE)
        Tween(title, {
            TextColor3 = state and Theme.Text or Theme.Idle,
        }, STATE)

        if state then
            menu.Visible = true

            reposition()

            local width = button.AbsoluteSize.X / window.Scale.Scale

            menu.Size = UDim2.fromOffset(width, 0)

            Tween(menu, {
                Size = UDim2.fromOffset(width, menuHeight),
            }, SMOOTH)

            follow = RunService.RenderStepped:Connect(reposition)
        else
            if follow then
                follow:Disconnect()

                follow = nil
            end

            Tween(menu, {
                Size = UDim2.fromOffset(menu.Size.X.Offset, 0),
            }, SNAP)
            task.delay(0.2, function()
                if not open then
                    menu.Visible = false
                end
            end)
        end
    end
    local function addRow(option, index)
        local row = New('TextButton', {
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = Theme.Rise,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = '',
            AutoButtonColor = false,
            LayoutOrder = index,
            ZIndex = 102,
            Parent = menuList,
        })

        Corner(row, 10)
        Padding(row, 0, 10, 0, 10)
        row.MouseEnter:Connect(function()
            Tween(row, {BackgroundTransparency = 0.4}, SNAP)
        end)
        row.MouseLeave:Connect(function()
            Tween(row, {BackgroundTransparency = 1}, SNAP)
        end)

        local dot = Accented(New('Frame', {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(6, 6),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 103,
            Parent = row,
        }), 'BackgroundColor3')

        Corner(dot, 99)

        local text = New('TextLabel', {
            Size = UDim2.new(1, -14, 1, 0),
            BackgroundTransparency = 1,
            FontFace = Fonts.Regular,
            Text = option,
            TextSize = 14,
            TextColor3 = Theme.Idle,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 103,
            Parent = row,
        })

        rows[option] = {
            Label = text,
            Dot = dot,
        }

        row.MouseButton1Click:Connect(function()
            if multi then
                selected[option] = not selected[option] or nil
            else
                selected = {[option] = true}

                setOpen(false)
            end

            local current = refresh()

            if config.Callback then
                task.spawn(config.Callback, current)
            end
        end)

        rows[option].Row = row
    end

    for index, option in ipairs(options)do
        addRow(option, index)
    end

    button.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)
    UserInputService.InputBegan:Connect(function(input)
        if not open then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if not InBounds(menu, input.Position) and not InBounds(button, input.Position) then
            setOpen(false)
        end
    end)

    local control = {}

    function control:Set(value, silent)
        selected = {}

        if type(value) == 'table' then
            for _, item in ipairs(value)do
                selected[item] = true
            end
        elseif value ~= nil then
            selected[value] = true
        end

        local current = refresh()

        if not silent and config.Callback then
            task.spawn(config.Callback, current)
        end

        return current
    end
    function control:Get()
        local picked = {}

        for _, option in ipairs(options)do
            if selected[option] then
                table.insert(picked, option)
            end
        end

        return multi and picked or picked[1]
    end
    function control:SetOptions(list)
        setOpen(false)

        for _, entry in pairs(rows)do
            entry.Row:Destroy()
        end

        local previous = selected

        rows = {}
        options = list or {}
        selected = {}

        for index, option in ipairs(options)do
            if previous[option] then
                selected[option] = true
            end

            addRow(option, index)
        end

        menuHeight = math.min(#options * 34 + 12, 220)

        refresh()
    end

    control.Type = 'Dropdown'
    control.Name = config.Name
    control.Scope = self.Scope
    control.Section = self.Section

    if flag then
        Library.Controls[flag] = control
    end

    refresh()

    return control
end
function Group:Keybind(config)
    config = config or {}

    local flag = FlagFor(config)
    local frame, slot, title = self:_row(config, SLOT_FOR.Keybind)
    local binder = Chrome.Keybinder(slot, config.Default, function()
        if config.Callback then
            task.spawn(config.Callback)
        end
    end, nil, function(listening)
        Tween(title, {
            TextColor3 = listening and Theme.Text or Theme.Idle,
        }, STATE)
    end, function(key)

        if flag then
            Library.Flags[flag] = key and key.Name or nil
            Library:MarkDirty()
        end
    end)
    local control = {}

    function control:Set(key)

        if type(key) == 'string' then
            local resolved

            local ok = pcall(function()
                resolved = Enum.KeyCode[key]
            end)

            if not ok or not resolved then
                pcall(function()
                    resolved = Enum.UserInputType[key]
                end)
            end

            key = resolved
        end

        binder.SetKey(key)

        if flag then
            Library.Flags[flag] = key and key.Name or nil
            Library:MarkDirty()
        end
    end
    function control:Get()
        return binder.GetKey()
    end

    control.Type = 'Keybind'
    control.Name = config.Name
    control.Scope = self.Scope
    control.Section = self.Section

    if flag then
        Library.Controls[flag] = control
        Library.Flags[flag] = config.Default and config.Default.Name or nil
        Library:MarkDirty()
    end

    return control
end
