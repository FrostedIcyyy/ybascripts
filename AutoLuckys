            end

            local alpha = 1 - math.exp(-DRAG_FOLLOW * delta)

            root.Position = UDim2.new(target.X.Scale, current.X.Offset + dx * alpha, target.Y.Scale, current.Y.Offset + dy * alpha)
        end)
    end

