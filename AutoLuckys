function Chrome.Keybinder(parent, initialKey, onFire, onResize, onListen, onChange)

    local key = initialKey
    local listening = false
    local chip = New('TextButton', {
        Name = 'Keybind',
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(0, 0),

        BackgroundColor3 = Theme.Track,
        BorderSizePixel = 0,
        FontFace = Fonts.Medium,
        Text = KeyLabel(key),
        TextSize = CHIP_TEXT,
        TextColor3 = Theme.Value,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        AutoButtonColor = false,
        Parent = parent,
    })

    Corner(chip, 10)

    local function layout()
        chip.Text = listening and '[ ... ]' or KeyLabel(key)

        local measured = TextService:GetTextSize(
            chip.Text, CHIP_TEXT, MEASURE, Vector2.new(400, 50)
        )

        local height = math.ceil(measured.Y) + CHIP_PAD * 2
        local width = math.max(height, math.ceil(measured.X) + CHIP_PAD * 2)

        chip.Size = UDim2.fromOffset(width, height)

        if onResize then
            onResize(width)
        end
    end

    chip.MouseButton1Click:Connect(function()
        listening = not listening

        if not listening then
            layout()
            Tween(chip, {
                TextColor3 = Theme.Value,
            }, STATE)

            if onListen then
                onListen(false)
            end

            return
        end

        layout()

        Tween(chip, {
            TextColor3 = Theme.Accent,
        }, STATE)

        if onListen then
            onListen(true)
        end
    end)

    local MOUSE = {
        [Enum.UserInputType.MouseButton1] = true,
        [Enum.UserInputType.MouseButton2] = true,
        [Enum.UserInputType.MouseButton3] = true,
    }

    local function Bindable(input)
        if MOUSE[input.UserInputType] then
            return input.UserInputType
        end

        if input.UserInputType == Enum.UserInputType.Keyboard
            or input.UserInputType == Enum.UserInputType.Gamepad1
            or input.UserInputType == Enum.UserInputType.Gamepad2
            or input.UserInputType == Enum.UserInputType.Gamepad3
            or input.UserInputType == Enum.UserInputType.Gamepad4 then
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                return input.KeyCode
            end
        end

        return nil
    end

    local function Matches(input, bound)
        if not bound then return false end

        if MOUSE[bound] then
            return input.UserInputType == bound
        end

        return input.KeyCode == bound
    end

    UserInputService.InputBegan:Connect(function(input, processed)
        if listening then

            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                return
            end

            local candidate = Bindable(input)

            if not candidate then
                return
            end

            listening = false

            if candidate == Enum.KeyCode.Backspace or candidate == Enum.KeyCode.Escape then
                key = nil
            else
                key = candidate
            end

            layout()
            Tween(chip, {
                TextColor3 = Theme.Value,
            }, STATE)

            if onListen then
                onListen(false)
            end

            if onChange then
                onChange(key)
            end

            return
        end
        if processed or not key or not Matches(input, key) then
            return
        end
        if UserInputService:GetFocusedTextBox() then
            return
        end

        onFire()
    end)
    layout()

    return {
        Chip = chip,
        GetKey = function()
            return key
        end,
        SetKey = function(newKey)
            key = newKey

            layout()
        end,
    }
end
