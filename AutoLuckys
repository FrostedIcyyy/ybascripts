function Social:Rpc(name, fields)
    if not ChatPassReady() then

        local deadline = os.clock() + 8

        while os.clock() < deadline and Session.Asking and not Session.Pass do
            task.wait(0.25)
        end
    end

    if not ChatPassReady() then
        return false, 'still signing in - give it a second and try again'
    end

    fields.p_discord = tostring(Session.Pass.discord)
    fields.p_roblox = tostring(Session.Pass.roblox)
    fields.p_expires = Session.Pass.expires
    fields.p_token = Session.Pass.token

    local ok, payload = pcall(function()
        return HttpService:JSONEncode(fields)
    end)

    if not ok then
        return false, 'could not encode'
    end

    local response, err = HttpRequest({
        Url = Social._url('rpc/' .. name),
        Method = 'POST',
        Headers = Social._headers2(),
        Body = payload,
    })

    if not response then
        return false, err
    end

    if not response.Success then
        if response.StatusCode == 400 or response.StatusCode == 401 then
            Session.Pass = nil
        end

        local decoded, detail = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)

        if decoded and type(detail) == 'table' and detail.message then
            return false, (tostring(detail.message):gsub('^%a+: ', ''))
        end

        return false, 'server returned ' .. tostring(response.StatusCode)
    end

    return true, response.Body
end

