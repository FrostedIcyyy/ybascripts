        BorderSizePixel = 0,
        Parent = slot,
    })

    Corner(track, 99)

    local knob = New('Frame', {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(SW_KNOB, SW_KNOB),
        BackgroundColor3 = Theme.Dim,
        BorderSizePixel = 0,
        Parent = track,
    })

    Corner(knob, 99)

    local control = {}

    function control:Set(state, silent)
        value = state and true or false

        cancelHover()
        Tween(track, {
            BackgroundColor3 = value and Theme.AccentTrack or Theme.Track,
        }, TOGGLE)
        Tween(knob, {
            Position = UDim2.new(0, value and (SW_W - SW_KNOB - 3) or 3, 0.5, 0),
            BackgroundColor3 = value and Theme.Accent or Theme.Dim,
        }, TOGGLE)
        Tween(title, {
            TextColor3 = value and Theme.Text or Theme.Idle,
        }, TOGGLE)

        if desc then
            Tween(desc, {
                TextColor3 = value and Theme.Muted or Theme.DescOff,
            }, TOGGLE)
        end
        if flag then
            Library.Flags[flag] = value
            Library:MarkDirty()
        end
        if not silent and config.Callback then
            task.spawn(config.Callback, value)
        end
    end
    function control:Get()
        return value
    end

    button.MouseButton1Click:Connect(function()
        control:Set(not value)
    end)
    OnAccent(function()
        if value then
            Tween(track, {
                BackgroundColor3 = Theme.AccentTrack,
            }, STATE)
            Tween(knob, {
                BackgroundColor3 = Theme.Accent,
            }, STATE)
        end
    end)

    control.Type = 'Toggle'
    control.Name = config.Name
    control.Scope = self.Scope
    control.Section = self.Section

    if flag then
        Library.Controls[flag] = control
    end

    control:Set(value, true)

    return control
end
function Group:Slider(config)
    config = config or {}

    local flag = FlagFor(config)
    local min = config.Min or 0
    local max = config.Max or 100
    local step = config.Step or 1
    local suffix = config.Suffix or ''
    local decimals = DecimalsOf(step)
    local value = config.Default or min
    local frame, slot, title = self:_row(config, SLOT_FOR.Slider)
    local readout = New('TextBox', {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -SL_W - 12, 0.5, 0),
        Size = UDim2.fromOffset(SLOT_FOR.Slider - SL_W - 12, 20),
