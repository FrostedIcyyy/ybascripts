        Parent = window.Overlay,
    })

    Corner(menu, 16)
    Stroke(menu, Theme.WindowBrd)

    local menuList = New('ScrollingFrame', {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        ScrollBarImageTransparency = 1,
