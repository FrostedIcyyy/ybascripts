local CHROME = {
    Settings = true,
    Configs = true,
    Chat = true,
}

local MASTER_KEYS = {'Enabled', 'enabled'}

function Library:_master(flag)
    local prefix, last = flag:match('^(.+)%.([^.]+)$')

    if not prefix then
        return nil
    end

    for _, key in ipairs(MASTER_KEYS)do
        if last == key then
            return prefix, nil
        end
    end
    for _, key in ipairs(MASTER_KEYS)do
        local candidate = prefix .. '.' .. key

        if self.Controls[candidate] then
            return prefix, candidate
        end
    end

    return prefix, nil
end

function Library:Summarise(data)
    if type(data) ~= 'table' then
        return {}
    end

    local sections = {}
    local order = {}

    for flag, value in pairs(data)do
        local control = flag ~= '__meta' and self.Controls[flag]
        local prefix, master = nil, nil

        if control then
            prefix, master = self:_master(flag)
        end

        if master and data[master] ~= true then
            control = nil
        end

        if control and not CHROME[control.Scope or ''] then
            local owner = prefix and self.FeatureLabels[prefix] or nil
            local label = control.Name or flag
            local line

            if not master and owner then
                label = owner
            end
            if control.Type == 'Toggle' then
                if value == true then
                    line = label
                end
            elseif control.Type == 'Slider' then
                line = ('%s: %s'):format(label, tostring(value))
            elseif type(value) == 'table' then
                line = ('%s: %s'):format(label, table.concat(value, ', '))
            elseif value ~= nil and value ~= '' then
                line = ('%s: %s'):format(label, tostring(value))
            end
            if line then
                local section = control.Section or 'Other'

                if not sections[section] then
                    sections[section] = {}

                    table.insert(order, section)
                end

                table.insert(sections[section], {
                    Owner = owner or '',

                    Rank = master and 1 or 0,
                    Text = line,
                })
            end
        end
    end

    table.sort(order)

    local lines = {}

    for _, section in ipairs(order)do
        table.sort(sections[section], function(a, b)
            if a.Owner ~= b.Owner then
                return a.Owner < b.Owner
            end
            if a.Rank ~= b.Rank then
                return a.Rank < b.Rank
            end

            return a.Text < b.Text
        end)
        table.insert(lines, section:upper())

        for _, entry in ipairs(sections[section])do
            table.insert(lines, (entry.Rank == 1 and '    ' or '  ') .. entry.Text)
        end
    end

    return lines
end

