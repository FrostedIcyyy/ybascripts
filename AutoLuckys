function Social:Fetch()
    if not self:Ready() then
        return nil
    end

    local url

    if self.LastId then
        url = Social._url(self.Messages) .. ('?select=*&id=gt.%d&order=id.asc&limit=%d'):format(self.LastId, self.HISTORY)
    else
        url = Social._url(self.Messages) .. ('?select=*&order=id.desc&limit=%d'):format(self.HISTORY)
    end

    local response = HttpRequest({
        Url = url,
        Headers = Social._headers2(),
    })

    if not response or not response.Success then
        return nil
    end

    local ok, rows = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not ok or type(rows) ~= 'table' then
        return nil
    end
    if not self.LastId then
        local flipped = {}

        for index = #rows, 1, -1 do
            table.insert(flipped, rows[index])
        end

        rows = flipped
    end

    self:Remember(rows)

    for _, row in ipairs(rows)do
        local id = tonumber(row.id)

        if id and (not self.LastId or id > self.LastId) then
            self.LastId = id
        end

        row.body = self.Censor and Censor(row.body) or row.body

        if row.kind == 'invite' then
            for index = #self.Log, 1, -1 do
                local earlier = self.Log[index]

                if earlier.kind == 'invite' and earlier.user_id == row.user_id then
                    table.remove(self.Log, index)
                end
            end
        end

        table.insert(self.Log, row)
    end

    while#self.Log > self.HISTORY * 2 do
        table.remove(self.Log, 1)
    end

    return rows
end

