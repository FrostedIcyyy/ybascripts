        end)
    end)

    task.spawn(function()
        while self.Running do
            pcall(function()
                local fresh = self:Fetch()

                if fresh and #fresh > 0 and self.OnMessages then
                    self.OnMessages(self.Log, fresh)
                end
            end)
            pcall(function()
                local waiting = self:Incoming()

                if self.OnRequests then
                    self.OnRequests(waiting)
                end

                for _, request in ipairs(waiting)do
                    if not self.Handled[request.id] and self.OnRequest then
                        self.Handled[request.id] = true

                        self.OnRequest(request)
                    end
                end

                if self.Pending > 0 then
                    for _, request in ipairs(self:Answered())do
                        if not self.Handled[request.id] then
                            self.Handled[request.id] = true
                            self.Pending = math.max(0, self.Pending - 1)

                            local stamp = Social:Stamp(request.created_at)

                            if stamp and self.Since and stamp < self.Since - 5 then
                                continue
                            end

                            if self.OnAnswer then
                                self.OnAnswer(request)
                            end
                        end
                    end
                end
            end)
            task.wait(self.POLL)
        end
    end)

    task.spawn(function()
        while self.Running do
            pcall(function()
                self:Beat()
            end)
            task.wait(self.HEARTBEAT)
        end
    end)
    task.spawn(function()
        local lastSignature = nil
        local lastRebuild = 0

        while self.Running do
            local fine, why = pcall(function()
                local rows = self:Poll()

                if rows then
                    self.Online = rows

                    local signature = self:Signature(rows)

                    local stale = os.clock() - lastRebuild >= self.REBUILD

                    if signature ~= lastSignature or stale then
                        lastSignature = signature
                        lastRebuild = os.clock()

                        if self.OnPlayers then
                            self.OnPlayers(rows)
                        end
                    end
                end
            end)

            if not fine and not self._toldRoster then
                self._toldRoster = true

                warn('[Tyrant Hub] roster: ' .. tostring(why))
            end
            task.wait(self.ROSTER)
        end
    end)

    return true
end
