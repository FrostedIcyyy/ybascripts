function Chrome.OffsetY(position, dy)
    return UDim2.new(position.X.Scale, position.X.Offset, position.Y.Scale, position.Y.Offset + dy)
end

function Window:_restTransparency()
    return 1 - (self.Opacity or 1)
end

function Window:SetFitMode(mode)
    self.FitMode = mode == 'Resize' and 'Resize' or 'Scale'

    local height = (self.FitMode == 'Resize' and IS_TOUCH) and WINDOW_H_TOUCH or WINDOW_H

    if height ~= self.WindowH then
        self.WindowH = height
        self.Root.Size = UDim2.fromOffset(WINDOW_W, height)
    end
    if self._fit then
        self._fit()
    end
end

function Window:SetUserScale(value)
    self.UserScale = math.clamp(value, 0.5, 1.3)

    if self._fit then
        self._fit()
    end
end

function Window:SetOpacity(value)
    self.Opacity = math.clamp(value, 0.25, 1)

    if not HAS_GROUP then
        return
    end

    if self.Gui and self.Gui.Enabled then
        Fade(self.Root, self:_restTransparency(), SNAP)
    end
end

function Window:_playIntro()
    local rest = self.Root.Position

    self.Scale.Scale = self.BaseScale
    self.Root.Position = Chrome.OffsetY(rest, WINDOW_RISE)

    Tween(self.Root, {Position = rest}, WINDOW_IN)
    Fade(self.Root, self:_restTransparency(), WINDOW_IN)
end
function Window:_showHud(state)
    if not self.Hud then
        return
    end

    local row = self.Hud.Row

    if state then
        self.Hud.Gui.Enabled = true
        row.Position = UDim2.new(1, -HUD_EDGE, 0, HUD_EDGE - 12)

        Tween(row, {
            Position = UDim2.new(1, -HUD_EDGE, 0, HUD_EDGE),
        }, SMOOTH)
        Fade(row, 0, SMOOTH)
    else
        Tween(row, {
            Position = UDim2.new(1, -HUD_EDGE, 0, HUD_EDGE - 12),
        }, STATE)
        Fade(row, 1, STATE)
        task.delay(0.36, function()
            if not (self.Shown and self.HudEnabled) then
                self.Hud.Gui.Enabled = false
            end
        end)
    end
end
function Window:_showBackdrop(state)
    local info = state and SMOOTH or STATE

    Tween(self.Scrim, {
        BackgroundTransparency = state and 0.45 or 1,
    }, info)
    Tween(self.Blur, {
        Size = state and BLUR_SIZE or 0,
    }, info)
end
function Window:SetVisible(state)
    self.Shown = state

    if state then
        self.Gui.Enabled = true

        self:_playIntro()
    else
        local rest = self.Root.Position

        Tween(self.Root, {
            Position = Chrome.OffsetY(rest, WINDOW_RISE),
        }, WINDOW_OUT)
        Fade(self.Root, 1, WINDOW_OUT)
        task.delay(0.3, function()
            if not self.Shown then
                self.Gui.Enabled = false
                self.Root.Position = rest
            end
        end)
    end

    self:_showBackdrop(state and self.BlurEnabled)
    self:_showHud(state and self.HudEnabled)
end
function Window:SetBlurEnabled(state)
    self.BlurEnabled = state

    self:_showBackdrop(self.Shown and state)
end
function Window:SetHudEnabled(state)
    self.HudEnabled = state

    self:_showHud(self.Shown and state)
end
function Window:SetButtonEnabled(state)
    self.ButtonEnabled = state

    if self.ToggleButton then
        self.ToggleButton.Gui.Enabled = state
    end
end
function Window:SetEdgeHandleEnabled(state)
    self.EdgeEnabled = state

    self.EdgeHandle:SetVisible(state)
end
function Window:SetEdgeHandleVisible(state)
    self.EdgeHandle:SetBarVisible(state)
end
function Window:Destroy()
    self.Blur:Destroy()

    if self.Hud then
        self.Hud.Gui:Destroy()
    end
    if self.ToggleButton then
        self.ToggleButton.Gui:Destroy()
    end
    if self.EdgeHandle then
        self.EdgeHandle.Gui:Destroy()
    end

    self.Gui:Destroy()
